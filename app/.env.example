# PocketSkynet — deployment configuration.
#
# Sourced by `make start` (and therefore `https`, `http`, `restart`, `dev`)
# before the server is exec'd, with `set -a` so every assignment is exported.
# It is applied *over* the surrounding shell, so this file is the answer to
# "which chain is this deployment on" even when a profile exports something
# else — which is exactly the situation it exists to fix.
#
# This is the committed template. Copy it to .env and edit; .env itself is
# gitignored, so a deployment's real settings never land in the repository.

# --- persistence -----------------------------------------------------------
#
# Where this deployment keeps everything it owns: the SQLite database, the
# JSONL event log, uploaded files and images, generated TLS material and the
# JWT signing secret. One directory, so one backup captures all of it.
#
# Unset means ~/.pocketskynet — the CLI server, `make start` and the desktop
# app all resolve it the same way, so they share one database. The server
# prints the resolved path in its startup banner ("Stored on this machine").
# `make start DATA_DIR=…` and the `--data-dir` flag override even this.
#POCKETSKYNET_PATH=~/.pocketskynet

# --- chain -----------------------------------------------------------------
#
# The one knob. PocketSkynet resolves the network name, RPC endpoint and
# explorer from this id, so none of them can drift out of step with the chain
# they describe. `GET /api/networks` then serves exactly this chain and the
# client offers no way to change it.
#
#   25   Cronos EVM mainnet — real funds
#   338  Cronos EVM testnet
#
# Unset behaves as 25, so the default and this file agree.
VITE_CHAIN_ID=25

# --- on-chain message anchoring --------------------------------------------
#
# The wallet that publish transactions must pay, and the CRO price of an
# anchor. Both optional: with no wallet set, the publish flow is simply not
# offered.
#
# This is the **same anchor wallet the reference client uses** (its
# `VITE_FRUITNATION_WALLET`), so a hash published from PocketSkynet and one
# published from the React client land at the same address and are the same
# receipt. It is a public address — it receives, it never signs here.
VITE_FRUITNATION_WALLET=0xBCA909dc34ac1810e4E6A70EBAD29Ce2C5D0E8Ff
VITE_FRUITNATION_HASH_CRO=1.2

# --- browser wallet / Privy sign-in ----------------------------------------
#
# MetaMask needs no configuration: it is offered whenever `window.ethereum` is
# present, and the server cannot tell a MetaMask signature from a mnemonic one
# (both are plain EIP-191 from an EOA). `VITE_CHAIN_ID` above is what the login
# flow asks the wallet to switch to.
#
# The Privy app id, matching the reference client's `VITE_PRIVY_APPID`. Privy
# app ids are public client-side identifiers, not secrets.
#
# NOTE: the Yew client cannot use this yet. Privy ships as a React SDK
# (`@privy-io/react-auth`), and this client has no npm build step at all —
# Trunk copies static files and there is no bundler to resolve a node package.
# Wiring it needs a JS build stage and a vendored bundle; see docs/DESIGN.md.
# The id is recorded here so that work has one place to read it from.
VITE_PRIVY_APPID=cmmn9jde200gr0di9oyispy3i
