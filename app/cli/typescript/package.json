{
  "name": "pocketskynet-client-ts",
  "version": "0.1.0",
  "description": "TypeScript client library and CLI for the PocketSkynet server",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "bin": {
    "pskynet-ts": "./dist/src/cli.js"
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run test:unit && npm run test:integration",
    "test:unit": "node --test \"dist/test/unit/*.test.js\"",
    "test:integration": "node --test --test-concurrency=4 \"dist/test/integration/*.test.js\""
  },
  "dependencies": {
    "@noble/hashes": "^1.5.0",
    "@noble/secp256k1": "^2.1.0",
    "@scure/bip32": "^1.5.0",
    "@scure/bip39": "^1.4.0",
    "undici": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
