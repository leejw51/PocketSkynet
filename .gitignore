.DS_Store

# Browser-verification artifacts: the MCP Playwright driver writes console logs,
# page snapshots and screenshots here, and the skin work drops screenshots at the
# repo root. Both are evidence for a single review, not part of the tree.
.playwright-mcp/
/*.png

# Browser-test scratch: node_modules and the screenshots the scripts drop.
app/tests/browser/node_modules/
app/tests/e2e/node_modules/
app/tests/e2e/test-results/
